{
  "schema_version": 1,
  "runtime": "ros2-jazzy",
  "lessons": [
    {
      "id": "why_ros",
      "number": "1.1",
      "title": "Why robots use ROS2",
      "module_number": 1,
      "module_title": "ROS2 foundations",
      "markdown": "lessons/foundations/why_ros/README.md",
      "starter": "lessons/foundations/why_ros/starter.py",
      "checker": "ros_basics_v1",
      "target": null,
      "launch": "python",
      "learning": {
        "kind": "answers",
        "answers": {
          "ros_role": {
            "expected": "communication_and_tools",
            "label": "Explain the role of ROS2",
            "hint": "ROS2 helps programs exchange typed messages and provides development tools."
          },
          "node": {
            "expected": "running_ros_component",
            "label": "Identify a node",
            "hint": "A node is a running software component in a ROS system, not a sensor or a file."
          },
          "topic": {
            "expected": "named_message_channel",
            "label": "Identify a topic",
            "hint": "A topic is a named channel carrying messages of a specified type."
          }
        }
      },
      "project_files": {
        "src/answers.json": "lessons/foundations/why_ros/answers.json"
      }
    },
    {
      "id": "explore_nodes",
      "number": "1.2",
      "title": "Find and inspect a ROS2 node",
      "module_number": 1,
      "module_title": "ROS2 foundations",
      "markdown": "lessons/foundations/explore_nodes/README.md",
      "starter": "lessons/foundations/explore_nodes/starter.py",
      "checker": "ros_basics_v1",
      "target": null,
      "launch": "python",
      "learning": {
        "kind": "answers",
        "answers": {
          "node_name": {
            "expected": "/ondroid_bridge",
            "label": "Find the platform node",
            "hint": "Use ros2 node list or Inspector \u2192 Nodes; preserve the leading slash."
          },
          "publishes": {
            "expected": "/robot/pose",
            "label": "Find the coordinate publication",
            "hint": "Look under Publishers in ros2 node info /ondroid_bridge."
          },
          "subscribes": {
            "expected": "/robot/cmd_vel",
            "label": "Find the motion-command subscription",
            "hint": "Look under Subscribers for geometry_msgs/msg/Twist."
          }
        }
      },
      "project_files": {
        "src/answers.json": "lessons/foundations/explore_nodes/answers.json"
      }
    },
    {
      "id": "read_topics",
      "number": "1.3",
      "title": "Read a topic and understand its message",
      "module_number": 1,
      "module_title": "ROS2 foundations",
      "markdown": "lessons/foundations/read_topics/README.md",
      "starter": "lessons/foundations/read_topics/starter.py",
      "checker": "ros_basics_v1",
      "target": null,
      "launch": "python",
      "learning": {
        "kind": "answers",
        "answers": {
          "topic_name": {
            "expected": "/robot/pose",
            "label": "Identify the coordinate topic",
            "hint": "Find the platform coordinate topic with ros2 topic list -t."
          },
          "message_type": {
            "expected": "geometry_msgs/msg/PoseStamped",
            "label": "Identify the full message type",
            "hint": "Use ros2 topic info and keep the package/msg/type spelling."
          },
          "frame_id": {
            "expected": "map",
            "label": "Read header.frame_id",
            "hint": "Use ros2 topic echo /robot/pose --once and inspect header.frame_id."
          }
        }
      },
      "project_files": {
        "src/answers.json": "lessons/foundations/read_topics/answers.json"
      }
    },
    {
      "id": "publish_cli",
      "number": "1.4",
